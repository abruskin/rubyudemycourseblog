<h1 class="text-center mt-4">Log in</h1>
<div class="col-10">
   
    <%= form_with(scope: :session, url: login_path, class: "shadow p-3 mb-3 rounded", local:true) do |form| %>
    
    <div class="form-group-row">
         <%= form.label :email, class: "col-form-label" %>
        <div class="col-10">
            <%= form.text_field :email,  class: "form-control", placeholder: "Enter your email" %>
        </div>
    </div>

    <div class="form-group-row">
         <%= form.label :password, class: "col-form-label" %>
        <div class="col-10">
            <%= form.password_field :password,  class: "form-control", placeholder: "Enter your password" %>
        </div>
    </div>


  <div class="form-group row mt-3">
    <%= form.submit "Log in", class:"btn btn-outline-primary"%>
  </div>
  <% end %>
</div>