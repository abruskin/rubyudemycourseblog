<h1 class="text-center mt-4">Categories</h1>
<div class="container">
  <div class="flickr_pagination d-flex justify-content-center mb-5">
  <%= will_paginate @categories %>
</div>
<div class="col-4 mt-4">
    <% @categories.each do |category| %>
     
    <div class="card text-center shadow mb-5 bg-white rounded">
        
  <div class="card-body">
    <div class="card-title"><%= link_to category.name, category_path(category) %> </div>
     <div class="card-body"><%= pluralize(category.articles.count, "articles")%>  </div>
    </div>
  <div class="card-footer text-muted">
    <small>Created <%= time_ago_in_words(category.created_at) %> ago, edited <%= time_ago_in_words(category.updated_at) %> ago. </small>
  </div>
</div>
    <% end %>
    </div>
    <div class="flickr_pagination d-flex justify-content-center mb-5">
  <%= will_paginate @categories %>
</div>
</div>