<div id="<%= dom_id article %>">

<h2 class="text-center mt-4"><%=@article.title %> </h2>
 
<h1 class="text-center mt-4">Articles</h1>
<div class="container"> 
<div id="articles">
  
    <div class="col-8 mt-4">
    <div class="card text-center shadow mb-5 bg-white rounded">
  <div class="card-header font-italic">
    By <%= link_to @article.user.username, user_path(@article.user) %>
  </div>
  <div class="card-body">
     <div class="card-text text-start"><%= simple_format(@article.description) %>.</div>
   <% if logged_in? && (article.user == current_user || current_user.admin) %>
      <%= link_to "Edit", edit_article_path(@article), class: "btn btn-outline-secondary" %>
      <%= link_to "Delete", article_path(@article), class:"btn btn-outline-warning", method: :delete, onclick: "return confirm('Are you sure?')" %>
    <% end if %>
    </div>
  <div class="card-footer text-muted">
    <small>Created <%= time_ago_in_words(@article.created_at) %> ago, edited <%= time_ago_in_words(@article.updated_at) %> ago. </small>
  </div>
</div>
</div>
   

  </div>
</div>

</div>
