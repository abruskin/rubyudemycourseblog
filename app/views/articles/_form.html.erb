
 



  <div class="row justify-content-center">
  <div class="col-10">
  <%= render 'shared/errors', obj: @article %>
  <%= form_with(model: article, class:"shadow p-3 mb-5 bg-white rounded", local:true) do |form| %>
    <div class="form-group-row">
  <div class="col-2">
    <%= form.label :title, class: "col-form-label" %>
    </div>
    <div class="col-10">
    <%= form.text_field :title, class: "form-control" %>
    </div>
  </div>

  <div class="form-group-row">
  <div class="col-2">
    <%= form.label :description, class: "col-form-label" %>
    </div>
    <div class="col-10">
    <%= form.textarea :description, rows:10, class:"form-control" %>
    </div>
  </div>
<div class="form-group-row">
  <div class="col-2">
  <%= form.label :category, class: "col-form-label" %>
  </div>
  <div class="col-10">
  <%= form.collection_select(:category_ids, Category.all, :id, :name,
            { prompt: "Make your selection from the list below (can be empty)"}, { multiple: true, size: 3, class: "custom-select shadow rounded" }) %>
</div>
</div>
  </div>

  <div class="form-group row">

    <%= form.submit class:"btn btn-outline-primary"%>
  </div>

  

  
<% end %>
  <%= link_to "Back to articles", articles_path, class: "link-primary" %>

</div>
</div>
